# Split Silly server environment — copy to packages/server/.env and fill in.
DATABASE_URL=postgresql://postgres:***@172.17.0.1:5432/splitsilly
SESSION_SECRET=change…ring
PORT=3002

# Comma-free: the CORS allowlist is hardcoded in src/server.ts (allowedOrigins).
# Add new browser origins there when the app gains a host.

# Email (Resend SDK). Sender must be a sender verified under this API key.
# (sandbox: onboarding@resend.dev)
RESEND_API_KEY=
RESEND_…m

# Optional overrides
# UPLOAD_DIR=./uploads/receipts
# MAX_UPLOAD_SIZE=10485760
# EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1
# FRONTEND_BASE_URL=https://splitsilly.myziot.com
# ADMIN_API_KEY=optional…only)
